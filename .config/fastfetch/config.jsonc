{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "top": 0,
      "right": 4
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "title",
      "format": "              {user-name}@{host-name}",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "  ╭───────────────────────────────────────────"
    },

    {
      "type": "host",
      "key": "  │  Host      ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "  │  Kernel    ",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "  │  Uptime    ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "  │  Shell     ",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "  │"
    },

    {
      "type": "de",
      "key": "  │  DE        ",
      "keyColor": "yellow"
    },
    {
      "type": "os",
      "key": "  │  OS        ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  │  WM        ",
      "keyColor": "yellow"
    },
    {
      "type": "wmtheme",
      "key": "  │  WM Theme  ",
      "keyColor": "yellow"
    },
    {
      "type": "theme",
      "key": "  │  Theme     ",
      "keyColor": "yellow"
    },
    {
      "type": "icons",
      "key": "  │  Icons     ",
      "keyColor": "yellow"
    },
    {
      "type": "font",
      "key": "  │  Font      ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "  │  Terminal  ",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "  │"
    },

    {
      "type": "cpu",
      "key": "  │  CPU       ",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "  │  GPU       ",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "  │  Memory    ",
      "keyColor": "yellow"
    },
    {
      "type": "poweradapter",
      "key": "  │  Power     ",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "  │"
    },

    {
      "type": "locale",
      "key": "  │  Locale    ",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "  ╰───────────────────────────────────────────"
    }
  ]
}
