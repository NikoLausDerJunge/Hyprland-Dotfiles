[global]
    monitor = 1

    width = 350
    height = (0, 100)

    origin = top-right
    offset = (12, 12)

    timeout = 5s
    stack_duplicates = false
    notification_limit = 7

    padding = 14
    horizontal_padding = 12
    gap_size = 5

    font = Inter 10

    background = "#2d2b299d"
    foreground = "#e6e6e691"
    frame_color = "#c6bdb38f"

    frame_width = 1
    corner_radius = 10
