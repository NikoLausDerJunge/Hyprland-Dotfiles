{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "custom/distro",
    "hyprland/window",
    "mpris"
  ],

  "modules-center": [
    "clock",
    "hyprland/workspaces"
  ],

  "modules-right": [
    "group/audio",
    "pulseaudio#microphone",
    "memory",
    "cpu",
    "tray"
  ],

  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },

  "custom/distro": {
    "format": "",
    "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%d.%m.%Y}"
  },

  "hyprland/workspaces": {
    "all-outputs": false
  },

  "hyprland/window": {
      "format": "{title}",
      "separate-outputs": true,
      "max-length": 20,
      "icon": false,
      "icon-size": 15,
      "tooltip": false
  },

  "mpris": {
      "format": "♫    {title}",
      "format-paused": "󰏤    {title}",
      "max-length": 20,
      "interval": 1
  },
  
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "show-value": false
  },

  "pulseaudio": {
    "format": " {icon}  ",
    "format-muted": "",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "hands-free": "󰋋",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip": false
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": " ",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "tooltip": false
  },

  "memory": {
    "format": "    {used:0.1f}G",
    "tooltip": false,
    "interval": 10
  },

  "cpu": {
    "format": "   {usage}%",
    "tooltip": false,
    "interval": 10
  },

  "tray": {
    "spacing": 12,
    "icon-size": 15,
    "tooltip": false
  }
}
